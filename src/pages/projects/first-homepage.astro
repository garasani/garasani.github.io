---
import BaseLayout from '../../layouts/BaseLayout.astro';
import projects from '../../data/projects.json';

const project = projects.find((item) => item.slug === 'first-homepage');
---

<BaseLayout title="입력 | Projects" description="프로젝트 상세정보 페이지">
	<main class="page-shell">
		<p class="eyebrow">Project Detail</p>
		<h1>{project.title}</h1>

		<div class="project-detail">
			<section class="content-section">
				<h2>프로젝트 배경</h2>
				<p>{project.detail}</p>
			</section>

			<section class="content-section">
				<h2>내가 한 일</h2>
				<p>{project.role}</p>
			</section>

			<section class="content-section">
				<h2>사용 도구</h2>
				<p>{project.tools.join(', ')}</p>
			</section>

			<section class="content-section">
				<h2>결과 또는 배운 점</h2>
				<p>{project.result}</p>
			</section>
		</div>

		<a class="text-link" href="/projects/">프로젝트 목록으로 돌아가기</a>
	</main>
</BaseLayout>
